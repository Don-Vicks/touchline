generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
  SUSPENDED
  UNKNOWN
}

enum MarketCategory {
  PRE_MATCH
  PLAYER
  MATCH_EVENT
  LIVE
}

enum MarketStatus {
  PENDING
  AWAITING_SIGNATURE
  OPEN
  TRADING
  RESOLVED
  CANCELLED
  DISABLED
  FAILED
}

enum MarketSide {
  YES
  NO
}

enum PredictionStatus {
  QUOTED
  BUILT
  SUBMITTED
  CONFIRMED
  FAILED
}

enum PositionResult {
  PENDING
  CORRECT
  INCORRECT
  VOID
}

enum ChatChannel {
  MATCHROOM
  SQUAD
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?
  role         UserRole  @default(USER)
  xp           Int       @default(0)
  streak       Int       @default(0)
  bestStreak   Int       @default(0)
  seasonKey    String    @default("all")
  bannedAt     DateTime?
  mutedUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  wallets           Wallet[]
  squadMembers      SquadMember[]
  invitesSent       SquadInvite[]       @relation("InviteSender")
  predictions       Prediction[]
  messages          ChatMessage[]
  reactions         Reaction[]
  notifications     Notification[]
  xpTransactions    XPTransaction[]
  reportsFiled      Report[]            @relation("Reporter")
  reportsAgainst    Report[]            @relation("Reported")
  blocksInitiated   Block[]             @relation("Blocker")
  blocksReceived    Block[]             @relation("Blocked")
  matchroomMembers  MatchroomMember[]
  auditLogs         AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
}

model Wallet {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String    @unique
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  inviteCode  String   @unique
  createdById String
  seasonKey   String   @default("all")
  xp          Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  SquadMember[]
  invites  SquadInvite[]
  messages ChatMessage[]
}

model SquadMember {
  id       String   @id @default(cuid())
  squadId  String
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([squadId, userId])
  @@index([userId])
}

model SquadInvite {
  id          String   @id @default(cuid())
  squadId     String
  squad       Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  username    String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([username, status])
}

model Competition {
  id         String  @id @default(cuid())
  provider   String
  providerId String
  name       String
  country    String?
  imageUrl   String?
  hasCorners Boolean @default(false)
  hasCards   Boolean @default(false)
  hasShots   Boolean @default(false)

  seasons Season[]
  matches Match[]

  @@unique([provider, providerId])
}

model Season {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  provider      String
  providerId    String
  name          String
  isCurrent     Boolean     @default(false)

  matches Match[]

  @@unique([provider, providerId])
}

model Team {
  id         String  @id @default(cuid())
  provider   String
  providerId String
  name       String
  shortCode  String?
  imageUrl   String?

  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  players     Player[]

  @@unique([provider, providerId])
}

model Player {
  id         String  @id @default(cuid())
  provider   String
  providerId String
  teamId     String?
  team       Team?   @relation(fields: [teamId], references: [id])
  name       String
  imageUrl   String?

  @@unique([provider, providerId])
}

model Match {
  id            String      @id @default(cuid())
  provider      String
  providerId    String
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  seasonId      String?
  season        Season?     @relation(fields: [seasonId], references: [id])
  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffAt     DateTime
  status        MatchStatus
  minute        Int?
  extraMinute   Int?
  second        Int?
  homeScore     Int         @default(0)
  awayScore     Int         @default(0)
  htHomeScore   Int?
  htAwayScore   Int?
  venue         String?
  round         String?
  lengthMin     Int?
  providerState String?
  lastSyncedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  matchroom Matchroom?
  events    FootballEvent[]
  markets   Market[]

  @@unique([provider, providerId])
  @@index([status, kickoffAt])
  @@index([kickoffAt])
}

model Matchroom {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())

  members  MatchroomMember[]
  messages ChatMessage[]
}

model MatchroomMember {
  id          String    @id @default(cuid())
  matchroomId String
  matchroom   Matchroom @relation(fields: [matchroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@unique([matchroomId, userId])
}

model FootballEvent {
  id                String   @id @default(cuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  provider          String
  providerEventId   String
  type              String
  minute            Int
  extraMinute       Int?
  teamProviderId    String?
  playerName        String?
  relatedPlayerName String?
  detail            String?
  payload           Json
  processedAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([matchId, minute])
}

model MarketTemplate {
  id               String         @id
  name             String
  category         MarketCategory
  trigger          String
  questionTemplate String
  resolutionRule   String
  enabled          Boolean        @default(true)
}

model Market {
  id               String         @id @default(cuid())
  matchId          String
  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  templateId       String
  category         MarketCategory
  question         String
  resolutionRule   String
  resolutionSource String
  sourceEventId    String?
  startTime        DateTime
  endTime          DateTime
  resolutionTime   DateTime
  status           MarketStatus   @default(PENDING)
  marketType       String
  pantaMarketId    String?        @unique
  pantaCreateId    String?
  yesPrice         Decimal?       @db.Decimal(10, 6)
  noPrice          Decimal?       @db.Decimal(10, 6)
  phase            String?
  outcome          String?
  evidence         String?
  disabled         Boolean        @default(false)
  failureReason    String?
  dedupeKey        String         @unique
  subject          String?
  deadlineMinute   Int?
  startMinute      Int            @default(0)
  teamProviderId   String?
  playerName       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  predictions Prediction[]
  logs        MarketGenerationLog[]

  @@index([matchId, status])
}

model MarketGenerationLog {
  id        String   @id @default(cuid())
  marketId  String?
  market    Market?  @relation(fields: [marketId], references: [id], onDelete: SetNull)
  matchId   String?
  level     String
  message   String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
}

model Prediction {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId     String
  market       Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  side         MarketSide
  amountUsdc   Decimal          @db.Decimal(12, 2)
  shares       Decimal?         @db.Decimal(18, 6)
  avgPrice     Decimal?         @db.Decimal(10, 6)
  status       PredictionStatus @default(QUOTED)
  pantaQuoteId String?
  pantaOrderId String?
  signature    String?
  result       PositionResult   @default(PENDING)
  xpAwarded    Int              @default(0)
  isLive       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([marketId])
}

model XPTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String
  seasonKey    String   @default("all")
  marketId     String?
  predictionId String?  @unique
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatMessage {
  id          String      @id @default(cuid())
  channel     ChatChannel
  matchroomId String?
  matchroom   Matchroom?  @relation(fields: [matchroomId], references: [id], onDelete: Cascade)
  squadId     String?
  squad       Squad?      @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  replyToId   String?
  kind        String      @default("message")
  meta        Json?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  reactions Reaction[]

  @@index([matchroomId, createdAt])
  @@index([squadId, createdAt])
}

model Reaction {
  id        String       @id @default(cuid())
  messageId String?
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime     @default(now())

  @@unique([messageId, userId, emoji])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String?
  target       User?    @relation("Reported", fields: [targetUserId], references: [id])
  messageId    String?
  reason       String
  status       String   @default("open")
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model ProviderHealth {
  id        String   @id
  status    String
  detail    String?
  checkedAt DateTime @default(now())
}
