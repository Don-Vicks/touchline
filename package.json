{
  "name": "touchline",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "bufferutil",
      "utf-8-validate",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @touchline/api --filter @touchline/web dev",
    "dev:api": "pnpm --filter @touchline/api dev",
    "dev:web": "pnpm --filter @touchline/web dev",
    "test": "pnpm --filter @touchline/market-engine test",
    "db:generate": "pnpm --filter @touchline/api db:generate",
    "db:migrate": "pnpm --filter @touchline/api db:migrate",
    "build": "pnpm -r --filter @touchline/web --filter @touchline/api build"
  }
}
