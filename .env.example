DATABASE_URL=postgresql://donvicks@localhost:5432/touchline
REDIS_URL=redis://127.0.0.1:6379

# Session signing. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me
SESSION_SECRET=replace-me

# Sportmonks Football API 3.0 token. Required for live fixtures.
# League ids are Sportmonks subscription ids. Names and fixtures come from the API.
# 271 Danish Superliga, 501 Scottish Premiership. Premier League is 8 when the plan includes it.
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
FOOTBALL_LEAGUE_IDS=271,501
# Optional extra football feeds. OpenLigaDB, ESPN, and TheSportsDB run without these.
# football-data.org free token uses header X-Auth-Token. Client honors X-Requests-Available-Minute / X-RequestCounter-Reset.
FOOTBALL_DATA_TOKEN=
YOUTUBE_API_KEY=
API_FOOTBALL_KEY=
THESPORTSDB_API_KEY=3
FOOTBALL_POLL_MS=20000
FIXTURE_POLL_MS=120000

# Panta live API. Trailing slash is added by the client.
# https://docs.panta.market
PANTA_API_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=
# Public https image used as the Panta catalog image. Required to create markets.
PANTA_MARKET_IMAGE_URL=https://upload.wikimedia.org/wikipedia/commons/thumb/d/d3/Soccerball.svg/512px-Soccerball.svg.png
# Optional operator keypair (Solana id.json) that signs market-creation txs.
# User trades are never signed with this key. Leave empty to sign creates from the admin wallet.
PANTA_CREATOR_KEYPAIR_PATH=

# Optional Pinata. When PINATA_IMAGE_CID is set, Panta catalog cards use that IPFS image.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_IMAGE_CID=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

WEB_ORIGIN=http://localhost:3010
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# HMAC secret for /api/v1/webhooks/*. Fail closed when empty.
WEBHOOK_SECRET=

# Optional first admin. Only applied when no admin user exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SENTRY_DSN=
EMBED_WORKERS=true
LOG_LEVEL=info
